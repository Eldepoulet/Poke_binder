# Base PostgreSQL. DATABASE_URL est la connexion poolée (utilisée par l'app),
# DIRECT_URL la connexion directe (utilisée par les migrations Prisma).
# Neon fournit les deux ; en local, un Postgres de dev suffit et les deux
# variables peuvent pointer sur la même URL.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# Auth.js (login Google) — voir README.md pour la procédure Google Cloud Console
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_SECRET=""

# Préfixe du CDN servant les visuels de cartes (bucket Cloudflare R2).
# Laisser vide en local pour utiliser les fichiers de public/cards.
CARDS_CDN_URL=""

# Injecté automatiquement par Vercel quand un store Blob est lié au projet.
# En local, le récupérer avec `vercel env pull`.
BLOB_READ_WRITE_TOKEN=""
